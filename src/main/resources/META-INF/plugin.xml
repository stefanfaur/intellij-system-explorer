<idea-plugin>
    <id>com.github.stefanfaur.systemexplorer</id>
    <name>System Explorer</name>
    <vendor>stefanfaur</vendor>
    <description><![CDATA[
<p>A full-featured system file browser embedded directly in your IntelliJ IDEA tool window.
Navigate, manage, and operate on files across your entire filesystem without leaving the IDE.</p>

<h3>Features</h3>
<ul>
  <li>Browse the entire filesystem in a tree view</li>
  <li>Copy, move, rename, and delete files and directories</li>
  <li>Bookmarks sidebar for quick access to frequently used directories</li>
  <li>Drag-and-drop between System Explorer and Project view</li>
  <li>Quick Open dialog for fast directory navigation by path</li>
  <li>Context menu with all file operations</li>
  <li>Filter files by glob pattern</li>
  <li>Status bar with selection info</li>
</ul>

<h3>Settings</h3>
<ul>
  <li>Show/hide hidden files</li>
  <li>Sort folders first</li>
  <li>Confirm before delete</li>
  <li>Delete to system trash</li>
</ul>

<h3>Keyboard Shortcuts</h3>
<ul>
  <li><b>Alt+E</b> &mdash; Toggle System Explorer panel</li>
  <li><b>Ctrl+C / Ctrl+X / Ctrl+V</b> &mdash; Copy, cut, paste files</li>
  <li><b>F2</b> &mdash; Rename selected file</li>
  <li><b>Delete</b> &mdash; Delete selected files</li>
  <li><b>F5</b> &mdash; Refresh file tree</li>
  <li><b>Ctrl+Shift+O</b> &mdash; Quick Open directory</li>
  <li><b>Ctrl+Shift+C</b> &mdash; Copy file path</li>
</ul>
]]></description>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.github.stefanfaur.explorer.settings.ExplorerSettings"/>
        <applicationService serviceImplementation="com.github.stefanfaur.explorer.model.BookmarkManager"/>
        <toolWindow id="System Explorer"
                    anchor="right"
                    factoryClass="com.github.stefanfaur.explorer.ExplorerToolWindowFactory"/>
        <applicationConfigurable id="com.github.stefanfaur.explorer.settings"
                                 displayName="System Explorer"
                                 parentId="tools"
                                 instance="com.github.stefanfaur.explorer.settings.ExplorerConfigurable"/>
    </extensions>

    <actions>
        <!-- Toggle System Explorer tool window (global shortcut) -->
        <action id="SystemExplorer.Toggle"
                class="com.github.stefanfaur.explorer.actions.ToggleExplorerAction"
                text="Toggle System Explorer"
                description="Show or hide the System Explorer tool window">
            <keyboard-shortcut keymap="$default" first-keystroke="alt E"/>
        </action>

        <!-- File operation actions scoped to the System Explorer tool window -->
        <group id="SystemExplorer.ActionGroup" text="System Explorer Actions" popup="false">
            <action id="SystemExplorer.CopyFiles"
                    class="com.github.stefanfaur.explorer.actions.CopyFilesAction"
                    text="Copy"
                    description="Copy selected files to clipboard">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl C"/>
            </action>

            <action id="SystemExplorer.CutFiles"
                    class="com.github.stefanfaur.explorer.actions.CutFilesAction"
                    text="Cut"
                    description="Cut selected files (move on paste)">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl X"/>
            </action>

            <action id="SystemExplorer.PasteFiles"
                    class="com.github.stefanfaur.explorer.actions.PasteFilesAction"
                    text="Paste"
                    description="Paste files from clipboard">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl V"/>
            </action>

            <action id="SystemExplorer.CopyPath"
                    class="com.github.stefanfaur.explorer.actions.CopyPathAction"
                    text="Copy Path"
                    description="Copy absolute path of selected file">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift C"/>
            </action>

            <action id="SystemExplorer.RenameFile"
                    class="com.github.stefanfaur.explorer.actions.RenameFileAction"
                    text="Rename"
                    description="Rename selected file">
                <keyboard-shortcut keymap="$default" first-keystroke="F2"/>
            </action>

            <action id="SystemExplorer.DeleteFiles"
                    class="com.github.stefanfaur.explorer.actions.DeleteFilesAction"
                    text="Delete"
                    description="Delete selected files">
                <keyboard-shortcut keymap="$default" first-keystroke="DELETE"/>
            </action>

            <action id="SystemExplorer.RefreshTree"
                    class="com.github.stefanfaur.explorer.actions.RefreshTreeAction"
                    text="Refresh"
                    description="Refresh the file tree">
                <keyboard-shortcut keymap="$default" first-keystroke="F5"/>
            </action>

        </group>

        <!-- Quick Open as a global action (works without System Explorer focused) -->
        <action id="SystemExplorer.QuickOpen"
                class="com.github.stefanfaur.explorer.actions.QuickOpenAction"
                text="Quick Open Directory"
                description="Open a directory in System Explorer by typing its path">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift O"/>
        </action>
    </actions>
</idea-plugin>
