<idea-plugin require-restart="true">
    <id>ro.faur.systemexplorer</id>
    <name>System Explorer</name>
    <vendor email="stefan@faur.sh" url="https://faur.sh">Stefan Faur</vendor>
    <description><![CDATA[
<p>A full-featured system file browser embedded directly in the IntelliJ IDEA tool window.
Navigate, manage, and operate on files across your entire filesystem without leaving the IDE.</p>

<h3>Features</h3>
<ul>
  <li>Browse the entire filesystem in a tree view</li>
  <li>Copy, move, rename, and delete files and directories</li>
  <li>Bookmarks sidebar for quick access to frequently used directories</li>
  <li>Drag-and-drop between System Explorer and Project view</li>
  <li>Quick Open v2 — fuzzy search popup with frecency ranking, query language, preview pane, and content search</li>
  <li>Quick Open dialog for fast directory navigation by path</li>
  <li>Context menu with all file operations</li>
  <li>Filter files by glob pattern</li>
  <li>Status bar with selection info</li>
</ul>

<h3>Settings</h3>
<ul>
  <li>Show/hide hidden files</li>
  <li>Sort folders first</li>
  <li>Confirm before delete</li>
  <li>Delete to system trash</li>
</ul>

<h3>Keyboard Shortcuts</h3>
<ul>
  <li><b>Alt+E</b> &mdash; Toggle/focus System Explorer panel</li>
  <li><b>Enter</b> &mdash; Open selected file/folder in System Explorer</li>
  <li><b>Backspace</b> &mdash; Go back in System Explorer history</li>
  <li><b>Ctrl+C / Ctrl+X / Ctrl+V</b> &mdash; Copy, cut, paste files</li>
  <li><b>F2</b> &mdash; Rename selected file</li>
  <li><b>Delete</b> &mdash; Delete selected files</li>
  <li><b>F5</b> &mdash; Refresh file tree</li>
  <li><b>Cmd+Shift+P</b> &mdash; Quick Open (v2: fuzzy popup with query language; v1: path dialog)</li>
  <li><b>Tab</b> &mdash; Toggle preview pane in Quick Open v2</li>
  <li><b>Ctrl+R</b> &mdash; Cycle recent queries in Quick Open v2</li>
  <li><b>Ctrl+Shift+C</b> &mdash; Copy file path</li>
</ul>
]]></description>

    <change-notes><![CDATA[
<h3>1.0.0-pre-2</h3>
<ul>
  <li>Initial release</li>
  <li>Full filesystem browser with tree view</li>
  <li>File operations: copy, move, rename, delete</li>
  <li>Bookmarks sidebar for quick directory access</li>
  <li>Drag-and-drop support with Project view</li>
  <li>Quick Open dialog for fast navigation</li>
  <li>File filtering with glob patterns</li>
  <li>Configurable settings and keyboard shortcuts</li>
</ul>
]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="ro.faur.explorer.settings.ExplorerSettings"/>
        <applicationService serviceImplementation="ro.faur.explorer.model.BookmarkManager"/>
        <applicationService serviceImplementation="ro.faur.explorer.quickopen.ranking.FrecencyStore"/>
        <applicationService serviceImplementation="ro.faur.explorer.quickopen.aliases.TeleportAliasStore"/>
        <toolWindow id="System Explorer"
                    anchor="right"
                    factoryClass="ro.faur.explorer.ExplorerToolWindowFactory"/>
        <applicationConfigurable id="ro.faur.explorer.settings"
                                 displayName="System Explorer"
                                 parentId="tools"
                                 instance="ro.faur.explorer.settings.ExplorerConfigurable"/>
    </extensions>

    <actions>
        <!-- Toggle/focus System Explorer tool window (global shortcut) -->
        <action id="SystemExplorer.Toggle"
                class="ro.faur.explorer.actions.ToggleExplorerAction"
                text="Toggle System Explorer"
                description="Toggle System Explorer visibility and focus when shown">
            <keyboard-shortcut keymap="$default" first-keystroke="alt E"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt E" remove="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt E" remove="true"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="ctrl alt E"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="ctrl alt E"/>
        </action>

        <!-- File operation actions scoped to the System Explorer tool window -->
        <group id="SystemExplorer.ActionGroup" text="System Explorer Actions" popup="false">
            <action id="SystemExplorer.OpenSelected"
                    class="ro.faur.explorer.actions.OpenSelectedAction"
                    text="Open"
                    description="Open selected file or navigate into selected folder">
                <keyboard-shortcut keymap="$default" first-keystroke="ENTER"/>
            </action>

            <action id="SystemExplorer.Back"
                    class="ro.faur.explorer.actions.BackInExplorerAction"
                    text="Back"
                    description="Navigate back in System Explorer history">
                <keyboard-shortcut keymap="$default" first-keystroke="BACK_SPACE"/>
            </action>

            <action id="SystemExplorer.CopyFiles"
                    class="ro.faur.explorer.actions.CopyFilesAction"
                    text="Copy"
                    description="Copy selected files to clipboard">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl C"/>
            </action>

            <action id="SystemExplorer.CutFiles"
                    class="ro.faur.explorer.actions.CutFilesAction"
                    text="Cut"
                    description="Cut selected files (move on paste)">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl X"/>
            </action>

            <action id="SystemExplorer.PasteFiles"
                    class="ro.faur.explorer.actions.PasteFilesAction"
                    text="Paste"
                    description="Paste files from clipboard">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl V"/>
            </action>

            <action id="SystemExplorer.CopyPath"
                    class="ro.faur.explorer.actions.CopyPathAction"
                    text="Copy Path"
                    description="Copy absolute path of selected file">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift C"/>
            </action>

            <action id="SystemExplorer.RenameFile"
                    class="ro.faur.explorer.actions.RenameFileAction"
                    text="Rename"
                    description="Rename selected file">
                <keyboard-shortcut keymap="$default" first-keystroke="F2"/>
            </action>

            <action id="SystemExplorer.DeleteFiles"
                    class="ro.faur.explorer.actions.DeleteFilesAction"
                    text="Delete"
                    description="Delete selected files">
                <keyboard-shortcut keymap="$default" first-keystroke="DELETE"/>
            </action>

            <action id="SystemExplorer.RefreshTree"
                    class="ro.faur.explorer.actions.RefreshTreeAction"
                    text="Refresh"
                    description="Refresh the file tree">
                <keyboard-shortcut keymap="$default" first-keystroke="F5"/>
            </action>

        </group>

        <!-- Quick Open as a global action (works without System Explorer focused) -->
        <action id="SystemExplorer.QuickOpen"
                class="ro.faur.explorer.actions.QuickOpenAction"
                text="Quick Open Directory"
                description="Open a directory in System Explorer by typing its path">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift P"/>
        </action>
    </actions>
</idea-plugin>
